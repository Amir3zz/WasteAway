generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WasteCategory {
  EDIBLE_SURPLUS
  ORGANIC_COMPOST
}

enum LogisticsType {
  DROP_OFF
  PICKUP
}

enum DonationStatus {
  PENDING_DROPOFF
  VERIFIED
  POINTS_AWARDED
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  points       Int          @default(0)
  impactKg     Float        @default(0)

  donations    Donation[]
  redemptions  Redemption[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Donation {
  id             String          @id @default(cuid())

  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  category       WasteCategory
  weightKg       Float
  logisticsType  LogisticsType
  location       String?
  pickupDate     DateTime?

  status         DonationStatus  @default(PENDING_DROPOFF)
  pointsAwarded  Int             @default(0)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model Reward {
  id              String         @id @default(cuid())
  partnerName     String
  title           String
  description     String
  discountPercent Int
  costPoints     Int
  active          Boolean        @default(true)

  redemptions     Redemption[]

  createdAt       DateTime       @default(now())
}

model Redemption {
  id          String   @id @default(cuid())

  userId      String
  rewardId    String

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward      Reward  @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  pointsSpent Int
  redeemedAt  DateTime @default(now())

  @@index([userId])
  @@index([rewardId])
}